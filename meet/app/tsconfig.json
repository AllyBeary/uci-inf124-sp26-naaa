{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",

    "strict": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "skipLibCheck": true,
    "resolveJsonModule": true,

    "types": ["node"],

    "outDir": "./dist"
  },

  "include": ["./**/*.ts"],
  "exclude": ["node_modules", "dist"]
}